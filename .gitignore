# Per-host settings live in ~/.config/homeassistant/, never in the repo.
.env
*.env.local
config/*.env
!config/*.env.example

# Backups and anything copied out of a config dir
*.tar
*.tgz
*.tar.gz
*.tar.zst
*.sql.gz
secrets.yaml
.storage/

# Test and tooling leftovers
__pycache__/
*.pyc

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
