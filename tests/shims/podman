#!/usr/bin/env python3
"""tests/shims/podman: a podman double for tests/scripts-test.sh. It never touches real
containers: everything lives under $SHIM_STATE.

    containers/<name>/inspect.json   one podman-inspect object (State, Config, HostConfig, Mounts)
    containers/<name>/devices        one device path per line, for `podman exec NAME test -c DEV`
    images/<key>.json                {"id": ..., "labels": {...}} for an image reference
    volumes/<name>/                  volume content        secrets/<name>     secret data
    networks/<name>                  network marker        calls              every call, one per line

Only the --format strings the repo's scripts really use are implemented; an unknown one exits
99 so a test fails loudly instead of silently getting an empty string.
"""
import json
import os
import shutil
import subprocess
import sys
import tarfile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import shimlib  # noqa: E402

S = os.environ.get("SHIM_STATE")
if not S:
    sys.exit("shim podman: SHIM_STATE is not set")
ARGS = sys.argv[1:]
with open(os.path.join(S, "calls"), "a", encoding="utf-8") as f:
    f.write("podman " + " ".join(ARGS) + "\n")


def path(*p):
    return os.path.join(S, *p)


def imgkey(ref):
    return ref.replace("/", "_").replace(":", "_").replace("@", "_")


def read_json(p, default=None):
    try:
        with open(p, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def ctr(name):
    d = read_json(path("containers", name, "inspect.json"))
    return d[0] if isinstance(d, list) and d else (None if isinstance(d, list) else d)


def save_ctr(name, obj):
    with open(path("containers", name, "inspect.json"), "w", encoding="utf-8") as f:
        json.dump([obj], f)


def config_src(c):
    for m in c.get("Mounts", []):
        if m.get("Destination") == "/config":
            return m.get("Source", "")
    return ""


# The one pipe-separated template ql_capture_container uses to read a container's facts.
CAPTURE_FIELDS_FMT = (
    '{{.Id}}|{{.Image}}|{{.ImageName}}|{{.HostConfig.RestartPolicy.Name}}'
    '|{{.HostConfig.RestartPolicy.MaximumRetryCount}}|{{.Pod}}|{{.HostConfig.AutoRemove}}'
    '|{{.HostConfig.NetworkMode}}|{{index .Config.Labels "PODMAN_SYSTEMD_UNIT"}}'
    '|{{index .Config.Labels "io.podman.compose.project"}}'
    '|{{index .Config.Labels "com.docker.compose.service"}}'
)


def restart_policy(c):
    """(name, MaximumRetryCount) as podman reports them; an unset policy is the empty name."""
    rp = (c.get("HostConfig") or {}).get("RestartPolicy") or {}
    return rp.get("Name", ""), str(rp.get("MaximumRetryCount", 0))


def networks(c):
    return ((c.get("NetworkSettings") or {}).get("Networks") or {})


def label(c, key):
    """podman prints <no value> for a label that is not there."""
    return c["Config"].get("Labels", {}).get(key, "<no value>")


def capture_fields(c):
    pol, retries = restart_policy(c)
    hc = c.get("HostConfig") or {}
    return "|".join([
        c.get("Id", ""), c.get("Image", ""), c.get("ImageName", ""), pol, retries,
        c.get("Pod", ""), str(hc.get("AutoRemove", False)).lower(), hc.get("NetworkMode", ""),
        label(c, "PODMAN_SYSTEMD_UNIT"), label(c, "io.podman.compose.project"),
        label(c, "com.docker.compose.service"),
    ])


def fmt_container(f, c):
    health = (c.get("State", {}).get("Health") or {}).get("Status", "")
    table = {
        "{{.State.Running}}": lambda: str(c["State"].get("Running", False)).lower(),
        '{{index .Config.Labels "PODMAN_SYSTEMD_UNIT"}}': lambda: c["Config"].get("Labels", {}).get("PODMAN_SYSTEMD_UNIT", "<no value>"),
        "{{.ImageName}}": lambda: c.get("ImageName", ""),
        "{{json .Config.CreateCommand}}": lambda: json.dumps(c["Config"].get("CreateCommand", [])),
        '{{range .Mounts}}{{if eq .Destination "/config"}}{{.Source}}{{end}}{{end}}': lambda: config_src(c),
        "{{.State.Status}}|{{if .Config.Healthcheck}}hc{{end}}|{{if .State.Health}}{{.State.Health.Status}}{{end}}|{{.State.StartedAt}}":
            lambda: "%s|%s|%s|%s" % (c["State"].get("Status", ""), "hc" if c["Config"].get("Healthcheck") else "", health, c["State"].get("StartedAt", "")),
        '{{.State.Running}}|{{index .Config.Labels "PODMAN_SYSTEMD_UNIT"}}|{{.ImageName}}|{{.Config.StopTimeout}}|{{if .State.Health}}{{.State.Health.Status}}{{end}}':
            lambda: "%s|%s|%s|%s|%s" % (str(c["State"].get("Running", False)).lower(),
                                        c["Config"].get("Labels", {}).get("PODMAN_SYSTEMD_UNIT", "<no value>"),
                                        c.get("ImageName", ""), c["Config"].get("StopTimeout", ""), health),
        "{{range .Mounts}}{{$.Name}}|{{.Source}}{{println}}{{end}}":
            lambda: "".join("%s|%s\n" % (c.get("Name", ""), m.get("Source", "")) for m in c.get("Mounts", [])),
        # --- what quadlet-lib's capture / recreate helpers read ---------------------------
        "{{.HostConfig.RestartPolicy.Name}}": lambda: restart_policy(c)[0],
        "{{.Config.Image}}": lambda: c["Config"].get("Image", c.get("ImageName", "")),
        "{{.SizeRw}}": lambda: str(c.get("SizeRw", 0)),
        CAPTURE_FIELDS_FMT: lambda: capture_fields(c),
        '{{range .Config.CreateCommand}}{{printf "%s\\x00" .}}{{end}}':
            lambda: "".join(a + "\0" for a in c["Config"].get("CreateCommand", [])),
        "{{range .Mounts}}{{.Type}}|{{.Name}}|{{.Source}}|{{.Destination}}|{{.RW}}|{{.Propagation}}{{println}}{{end}}":
            lambda: "".join("%s|%s|%s|%s|%s|%s\n" % (m.get("Type", ""), m.get("Name", ""), m.get("Source", ""),
                                                     m.get("Destination", ""), str(m.get("RW", True)).lower(),
                                                     m.get("Propagation", "rprivate")) for m in c.get("Mounts", [])),
        "{{range $n, $v := .NetworkSettings.Networks}}{{$n}}|{{range $v.Aliases}}{{.}} {{end}}|{{$v.IPAddress}}|{{$v.MacAddress}}{{println}}{{end}}":
            lambda: "".join("%s|%s|%s|%s\n" % (n, "".join(a + " " for a in v.get("Aliases", [])),
                                               v.get("IPAddress", ""), v.get("MacAddress", ""))
                            for n, v in sorted(networks(c).items())),
        "{{range $n, $v := .NetworkSettings.Networks}}{{$n}}{{println}}{{end}}":
            lambda: "".join(n + "\n" for n in sorted(networks(c))),
        "{{range $p, $b := .NetworkSettings.Ports}}{{$p}}|{{range $b}}{{.HostIP}}:{{.HostPort}} {{end}}{{println}}{{end}}":
            lambda: "".join("%s|%s\n" % (p, "".join("%s:%s " % (b.get("HostIP", ""), b.get("HostPort", "")) for b in bs))
                            for p, bs in sorted((c.get("NetworkSettings") or {}).get("Ports", {}).items())),
        "{{range $k, $v := .Config.Labels}}{{$k}}={{$v}}{{println}}{{end}}":
            lambda: "".join("%s=%s\n" % (k, v) for k, v in sorted(c["Config"].get("Labels", {}).items())),
    }
    if f not in table:
        sys.exit("shim podman: unhandled container --format %r (add it to tests/shims/podman)" % f)
    return table[f]()


def take_format(args):
    """--format F / -f F anywhere in args; returns (format or None, remaining args)."""
    out, fmt, i = [], None, 0
    while i < len(args):
        if args[i] in ("--format", "-f") and i + 1 < len(args):
            fmt = args[i + 1]
            i += 2
            continue
        out.append(args[i])
        i += 1
    return fmt, out


def do_inspect(args):
    fmt, rest = take_format(args)
    rest = [a for a in rest if a not in ("--type", "container", "--size")]
    objs = []
    for name in rest:
        c = ctr(name)
        if c is None:
            print("Error: no such object: %s" % name, file=sys.stderr)
            return 125
        objs.append(c)
    if fmt is None:
        print(json.dumps(objs, indent=2))
        return 0
    for c in objs:
        out = fmt_container(fmt, c)
        print(out if out.endswith("\n") else out, end="" if out.endswith("\n") else "\n")
    return 0


def do_image(args):
    if args[:1] == ["exists"]:
        return 0 if os.path.exists(path("images", imgkey(args[1]) + ".json")) else 1
    if args[:1] == ["inspect"]:
        fmt, rest = take_format(args[1:])
        ref = rest[-1]
        data = read_json(path("images", imgkey(ref) + ".json"))
        if data is None:  # also accept an image id
            for f in os.listdir(path("images")) if os.path.isdir(path("images")) else []:
                d = read_json(path("images", f))
                if d and d.get("id") == ref:
                    data = d
                    break
        if data is None:
            print("Error: no such image: %s" % ref, file=sys.stderr)
            return 125
        if fmt == "{{.Id}}":
            print(data.get("id", ""))
        elif fmt == '{{index .Labels "io.hass.version"}}':
            print(data.get("labels", {}).get("io.hass.version", "<no value>"))
        elif fmt is None:
            print(json.dumps([data]))
        else:
            sys.exit("shim podman: unhandled image --format %r" % fmt)
        return 0
    return 0


def do_images(args):
    fmt, rest = take_format(args)
    repo = rest[0] if rest else ""
    if fmt != "{{.Repository}}:{{.Tag}}":
        sys.exit("shim podman: unhandled images --format %r" % fmt)
    d = path("images")
    for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        data = read_json(path("images", f)) or {}
        ref = data.get("ref", "")
        if ref and (not repo or ref.startswith(repo + ":") or ref == repo):
            print(ref)
    return 0


def do_pull(args):
    ref = args[-1]
    os.makedirs(path("images"), exist_ok=True)
    with open(path("images", imgkey(ref) + ".json"), "w", encoding="utf-8") as f:
        json.dump({"ref": ref, "id": "sha256:" + imgkey(ref), "labels": {}}, f)
    return 0


def do_secret(args):
    sub = args[0]
    os.makedirs(path("secrets"), exist_ok=True)
    if sub == "exists":
        return 0 if os.path.exists(path("secrets", args[1])) else 1
    if sub == "create":
        rest = [a for a in args[1:] if not a.startswith("--")]
        # drop --label values
        skip, clean = False, []
        for a in args[1:]:
            if skip:
                skip = False
                continue
            if a == "--label":
                skip = True
                continue
            if a.startswith("--"):
                continue
            clean.append(a)
        name, src = clean[0], clean[1]
        data = sys.stdin.buffer.read() if src == "-" else open(src, "rb").read()
        with open(path("secrets", name), "wb") as f:
            f.write(data)
        print("shimsecretid")
        return 0
    if sub == "inspect":
        name = args[-1]
        if not os.path.exists(path("secrets", name)):
            return 125
        sys.stdout.write(open(path("secrets", name), encoding="utf-8").read() + "\n")
        return 0
    if sub == "rm":
        if not os.path.exists(path("secrets", args[1])):
            return 1
        os.remove(path("secrets", args[1]))
        return 0
    return 0


def do_volume(args):
    sub = args[0]
    os.makedirs(path("volumes"), exist_ok=True)
    if sub == "exists":
        return 0 if os.path.isdir(path("volumes", args[1])) else 1
    if sub == "create":
        name = [a for a in args[1:] if not a.startswith("--")][-1]
        os.makedirs(path("volumes", name), exist_ok=True)
        return 0
    if sub == "export":
        vol = args[1]
        out = args[args.index("-o") + 1]
        with tarfile.open(out, "w") as t:
            t.add(path("volumes", vol), arcname=".")
        return 0
    if sub == "import":
        vol, src = args[1], args[2]
        os.makedirs(path("volumes", vol), exist_ok=True)
        with tarfile.open(src) as t:
            t.extractall(path("volumes", vol))
        return 0
    if sub == "inspect":
        fmt, rest = take_format(args[1:])
        if fmt == "{{.Mountpoint}}":
            print(path("volumes", rest[-1]))
            return 0
        print("")
        return 0
    if sub == "rm":
        name = [a for a in args[1:] if not a.startswith("-")][0]
        if not os.path.isdir(path("volumes", name)):
            return 1
        shutil.rmtree(path("volumes", name))
        return 0
    return 0


def do_network(args):
    sub = args[0]
    os.makedirs(path("networks"), exist_ok=True)
    if sub == "exists":
        return 0 if os.path.exists(path("networks", args[1])) else 1
    if sub == "rm":
        if not os.path.exists(path("networks", args[1])):
            return 1
        os.remove(path("networks", args[1]))
        return 0
    if sub == "inspect":
        print("")
        return 0
    return 0


def do_exec(args):
    args = [a for a in args if a not in ("-i", "-t", "-it")]
    name, cmd = args[0], args[1:]
    c = ctr(name)
    if c is None or not c["State"].get("Running"):
        print("Error: container %s is not running" % name, file=sys.stderr)
        return 125
    if cmd[:1] == ["test"]:
        dev = cmd[-1]
        devs = []
        p = path("containers", name, "devices")
        if os.path.exists(p):
            devs = [x.strip() for x in open(p, encoding="utf-8")]
        return 0 if dev in devs else 1
    if cmd[:2] == ["python3", "-c"]:
        # /config/... maps to the host path of the config bind mount
        src = config_src(c)
        mapped = [a.replace("/config", src, 1) if a.startswith("/config") else a for a in cmd[3:]]
        return subprocess.call([sys.executable, "-c", cmd[2]] + mapped)
    return 0


# flags of `podman create` that take a separate value; anything else starting with "-" is a
# switch, and the first bare token after the options is the image, as in real podman.
CREATE_VALUE_FLAGS = {
    "--name", "--restart", "-v", "--volume", "--net", "--network", "--label", "-l", "-e",
    "--env", "-p", "--publish", "--device", "--cidfile", "--detach-keys", "--healthcheck-command",
}


def do_create(args):
    rc = int(os.environ.get("SHIM_CREATE_RC", "0"))
    if rc:
        print("Error: shim create refused", file=sys.stderr)
        return rc
    name, policy, retries, image = "", "", 0, ""
    mounts, nets, labels, devices, privileged = [], [], {}, [], False
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("--") and "=" in a:
            k, v = a.split("=", 1)
        elif a in CREATE_VALUE_FLAGS and i + 1 < len(args):
            k, v = a, args[i + 1]
            i += 1
        elif a.startswith("-"):
            k, v = a, ""
        else:
            image = a
            break
        if k in ("--name",):
            name = v
        elif k in ("--restart",):
            policy = v.split(":")[0]
            retries = int(v.split(":")[1]) if ":" in v else 0
        elif k in ("-v", "--volume"):
            parts = v.split(":")
            src, dst = parts[0], (parts[1] if len(parts) > 1 else parts[0])
            mounts.append({"Type": "bind" if src.startswith("/") else "volume",
                           "Name": "" if src.startswith("/") else src,
                           "Source": src if src.startswith("/") else "/vol/" + src,
                           "Destination": dst, "RW": True, "Propagation": "rprivate"})
        elif k in ("--net", "--network"):
            nets.append(v)
        elif k in ("--label", "-l"):
            kk, _, vv = v.partition("=")
            labels[kk] = vv
        elif k in ("--device",):
            devices.append(v)
        elif k == "--privileged":
            privileged = True
        i += 1
    if not name:
        print("Error: shim create needs --name", file=sys.stderr)
        return 125
    if ctr(name) is not None:
        print("Error: container name %s is already in use" % name, file=sys.stderr)
        return 125
    netmode = nets[0] if nets else "bridge"
    img = read_json(path("images", imgkey(image) + ".json")) or {}
    obj = {
        "Name": name,
        "Id": "shimid-" + name,
        "Image": img.get("id", "sha256:" + imgkey(image)),
        "ImageName": image,
        "State": {"Running": False, "Status": "created", "StartedAt": "", "Health": None},
        "Config": {"Labels": labels, "CreateCommand": ["podman", "create"] + args,
                   "Env": [], "StopTimeout": 10, "Timezone": "", "Healthcheck": None,
                   "Image": image},
        "HostConfig": {"NetworkMode": netmode, "Privileged": privileged, "Devices": [],
                       "AutoRemove": False,
                       "RestartPolicy": {"Name": policy, "MaximumRetryCount": retries}},
        "NetworkSettings": {"Networks": {n: {"Aliases": [], "IPAddress": "", "MacAddress": ""}
                                         for n in nets if n not in ("host", "none")},
                            "Ports": {}},
        "Mounts": mounts,
        "SizeRw": 0,
    }
    os.makedirs(path("containers", name), exist_ok=True)
    save_ctr(name, obj)
    with open(path("containers", name, "devices"), "w", encoding="utf-8") as f:
        for spec in devices:
            parts = spec.split(":")
            f.write((parts[1] if len(parts) > 1 else parts[0]) + "\n")
    open(path("containers", name, "ports"), "w", encoding="utf-8").close()
    print("shimid-" + name)
    return 0


def main():
    if not ARGS:
        return 0
    if ARGS[0] == "--version":
        print("podman version %s" % os.environ.get("SHIM_PODMAN_VERSION", "4.9.3"))
        return 0
    cmd, rest = ARGS[0], ARGS[1:]
    if cmd == "container":
        if rest[0] == "exists":
            return 0 if ctr(rest[1]) is not None else 1
        if rest[0] == "inspect":
            return do_inspect(rest[1:])
        return 0
    if cmd == "inspect":
        return do_inspect(rest)
    if cmd in ("start", "stop", "rm"):
        names = [a for a in rest if not a.startswith("-")]
        # drop the value of -t/--time
        clean, skip = [], False
        for a in rest:
            if skip:
                skip = False
                continue
            if a in ("-t", "--time"):
                skip = True
                continue
            if not a.startswith("-"):
                clean.append(a)
        names = clean
        for n in names:
            c = ctr(n)
            if c is None:
                print("Error: no such container %s" % n, file=sys.stderr)
                return 125
            if cmd == "rm":
                shutil.rmtree(path("containers", n))
                continue
            c["State"]["Running"] = cmd == "start"
            c["State"]["Status"] = "running" if cmd == "start" else "exited"
            save_ctr(n, c)
        shimlib.sync_ports()
        return 0
    if cmd == "commit":
        rc = int(os.environ.get("SHIM_COMMIT_RC", "0"))
        if rc:
            print("Error: shim commit refused", file=sys.stderr)
            return rc
        plain = [a for a in rest if not a.startswith("-")]
        src, ref = plain[0], plain[1]
        if ctr(src) is None:
            print("Error: no such container %s" % src, file=sys.stderr)
            return 125
        os.makedirs(path("images"), exist_ok=True)
        with open(path("images", imgkey(ref) + ".json"), "w", encoding="utf-8") as f:
            json.dump({"ref": ref, "id": "sha256:committed-" + src, "labels": {}}, f)
        print("sha256:committed-" + src)
        return 0
    if cmd == "create":
        return do_create(rest)
    if cmd == "rename":
        old, new = rest[0], rest[1]
        if ctr(old) is None:
            print("Error: no such container %s" % old, file=sys.stderr)
            return 125
        os.rename(path("containers", old), path("containers", new))
        c = ctr(new)
        c["Name"] = new
        save_ctr(new, c)
        shimlib.sync_ports()
        return 0
    if cmd == "ps":
        names = []
        d = path("containers")
        for n in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            c = ctr(n)
            if c and c["State"].get("Running"):
                names.append(n)
        if "-q" in rest:
            print("\n".join(names))
        elif any(a.startswith("volume=") for a in rest):
            pass
        return 0
    if cmd == "image":
        return do_image(rest)
    if cmd == "images":
        return do_images(rest)
    if cmd == "pull":
        return do_pull(rest)
    if cmd == "rmi":
        ref = rest[-1]
        p = path("images", imgkey(ref) + ".json")
        if not os.path.exists(p):
            return 1
        os.remove(p)
        return 0
    if cmd == "secret":
        return do_secret(rest)
    if cmd == "volume":
        return do_volume(rest)
    if cmd == "network":
        return do_network(rest)
    if cmd == "exec":
        return do_exec(rest)
    if cmd == "unshare":
        return subprocess.call(rest)
    if cmd == "healthcheck":
        return int(os.environ.get("SHIM_HC_RC", "0"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
