# An unprivileged host: only the listed devices, the user's groups (dialout) via keep-groups,
# a pinned time zone, BlueZ over /run/dbus, and a config dir outside $HOME.
HA_CONFIG_DIR=/srv/homeassistant/config
HA_PORT=8123
HA_PRIVILEGED=false
HA_ZIGBEE_DEVICE=/dev/serial/by-id/usb-Nabu_Casa_ZBT-2-if00
HA_ZIGBEE_TARGET=/dev/ttyUSB0
HA_EXTRA_DEVICES=/dev/ttyACM1:/dev/ttyACM1:rwm
HA_TZ=Asia/Taipei
HA_BLUETOOTH=true
HA_MATTER=true
HA_MATTER_LISTEN_ADDRESS=
HA_POSTGRES=true
HA_DB_PORT=25432
HA_BACKUP_TIMER=true
HA_BACKUP_DIR=/srv/backups/homeassistant
HA_BACKUP_KEEP=7
