# What scripts/migrate-legacy.sh derives from `podman inspect homeassistant` on toypark1234.
# The cutover reproduces the legacy container exactly: privileged, the same device mapping
# (inert under --privileged; the by-id link resolves to /dev/ttyACM0), and no TZ, so UTC as
# today. HA_TZ=local and HA_PRIVILEGED=false are separate post-soak steps.
HA_CONFIG_DIR=%h/ha-config
HA_PORT=8123
HA_PRIVILEGED=true
HA_ZIGBEE_DEVICE=/dev/serial/by-id/usb-ITEAD_SONOFF_Zigbee_3.0_USB_Dongle_Plus_V2_20230803153503-if00
HA_ZIGBEE_TARGET=/dev/ttyACM0
HA_EXTRA_DEVICES=
HA_TZ=
HA_BLUETOOTH=false
HA_MATTER=false
HA_MATTER_LISTEN_ADDRESS=127.0.0.1
HA_POSTGRES=false
HA_DB_PORT=15432
HA_BACKUP_TIMER=false
HA_BACKUP_DIR=%h/backups/homeassistant
HA_BACKUP_KEEP=5
