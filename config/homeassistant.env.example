# Per-host settings for Home Assistant. scripts/install.sh copies this file to
# ~/.config/homeassistant/homeassistant.env (mode 0600) on the first run and renders the
# Quadlet units from it. systemd never reads it, and it holds no secrets.
#
# One KEY=value per line: no quotes, no spaces around "=", no comment after a value.
# %h means your home directory. Re-run scripts/install.sh after every change.

# Config dir bind-mounted at /config. Point it at an existing dir to adopt it.
HA_CONFIG_DIR=%h/homeassistant/config
# The port HA listens on (http: server_port). Used by the health check and tests/smoke.sh.
HA_PORT=8123

# true: --privileged, upstream's HA container setup (every host device is visible).
# false: only the devices below are passed, plus --group-add=keep-groups. See docs/hardware.md.
HA_PRIVILEGED=true
# Zigbee/Thread/Z-Wave stick, as its stable /dev/serial/by-id/ path. Empty = no stick.
HA_ZIGBEE_DEVICE=
# The path HA sees inside the container. It must match the path in the ZHA/Z-Wave config
# entry. With HA_PRIVILEGED=true podman ignores the mapping and HA sees the host's node
# names, so install.sh checks that the by-id link resolves to exactly this path.
HA_ZIGBEE_TARGET=/dev/ttyACM0
# More devices, space separated, each host[:container[:perms]].
HA_EXTRA_DEVICES=
# local = follow the host's /etc/localtime. An IANA name (Asia/Taipei) pins it. Empty = UTC.
HA_TZ=local
# true mounts /run/dbus read-only so the Bluetooth integration can reach BlueZ.
HA_BLUETOOTH=false

# Optional Matter server (install.sh --with-matter / --without-matter set this).
HA_MATTER=false
# Address the Matter WebSocket API binds to. It has no authentication, so keep it on loopback.
# Empty = all interfaces.
HA_MATTER_LISTEN_ADDRESS=127.0.0.1

# Optional PostgreSQL recorder (install.sh --with-postgres / --without-postgres).
HA_POSTGRES=false
# Loopback port the database is published on.
HA_DB_PORT=15432

# Optional daily hot backup timer (install.sh --with-backup-timer / --without-backup-timer).
HA_BACKUP_TIMER=false

# Where backup.sh, upgrade.sh, migrate-legacy.sh and uninstall.sh --purge write backups.
HA_BACKUP_DIR=%h/backups/homeassistant
# How many backups of each kind (hot, cold) backup.sh keeps. Upgrade, migration and purge
# backups are never deleted automatically.
HA_BACKUP_KEEP=5
